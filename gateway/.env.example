# ============================================================
# Gateway gửi tin LS-Routing — biến môi trường
# Chép thành .env khi chạy máy cục bộ. KHÔNG commit file .env.
# Khi chạy thật, nạp qua Secret Manager / biến môi trường của nền tảng.
# ============================================================

# --- Bắt buộc ---
# Token này phải trùng với giá trị nạp trong Apps Script:
# Project Settings -> Script properties -> LS_GATEWAY_TOKEN
# Sinh token: openssl rand -base64 36
GATEWAY_TOKEN=thay_bang_chuoi_ngau_nhien_toi_thieu_24_ky_tu

PORT=8080

# --- Kho khóa chống trùng và token xoay vòng ---
# memory: chỉ cho phát triển, mất khi khởi động lại và không dùng chung giữa các bản sao.
# firestore: dùng khi chạy thật.
STORE_DRIVER=memory
STORE_COLLECTION=ls_gateway
IDEMPOTENCY_TTL_DAYS=45

# --- Zalo ZNS (kênh ZBS) ---
ZNS_ENABLED=true
ZNS_OAUTH_URL=https://oauth.zaloapp.com/v4/oa/access_token
ZNS_SEND_URL=https://business.openapi.zalo.me/message/template
# Refresh token lấy một lần khi cấp quyền cho ứng dụng Zalo.
# Sau lần làm mới đầu tiên, giá trị mới được lưu vào kho; biến này chỉ dùng để mồi.
ZNS_REFRESH_TOKEN=
ZNS_TIMEOUT_MS=15000

# Bí mật tra theo secret_ref mà LS-Routing gửi sang.
# Tên biến phải TRÙNG giá trị ô "Tham chiếu khóa" trong Quản trị -> Kênh gửi tin.
LS_ZBS_SECRET=
LS_SMS_TOKEN=

# --- SMS ---
SMS_CONFIG_FILE=config/sms.json

# --- Telegram ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=15000

# --- Nhóm Zalo nội bộ (GMF) ---
# Chỉ bật khi đã xác nhận tổ chức có quyền gửi vào nhóm.
GMF_ENABLED=false
GMF_SEND_URL=

# --- Ánh xạ mẫu ZNS ---
TEMPLATE_MAP_FILE=config/templates.json

# --- Diễn tập ---
# true: không gọi nhà cung cấp nào, trả mã tin giả. Dùng để chạy thử đầu cuối.
MOCK_PROVIDERS=false
